{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "escritorio",
  "description": "La página la sirve el backend en 127.0.0.1, así que para Tauri es remota: sin esto no podría llamar a nada. Los comandos propios de main.rs, además, necesitan cada uno su permiso allow-<comando> (los genera build.rs): con sólo core:default, Tauri los rechazaba y «Guardar» y «Abrir con…» fallaban en silencio. Sólo este origen; cualquier otro no ve la IPC.",
  "windows": [
    "*"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-guardar-como",
    "allow-mostrar-guardado",
    "allow-archivos-pendientes",
    "allow-leer-archivo",
    "allow-menu-contextual",
    "allow-aplicar-menu-contextual",
    "allow-progreso-tarea",
    "allow-avisar-fin",
    "allow-resultado-autoprueba",
    "allow-nueva-ventana",
    "allow-actualizacion-pendiente",
    "allow-responder-actualizacion",
    "allow-buscar-actualizacion-ahora",
    "allow-leer-ajustes",
    "allow-guardar-ajustes",
    "allow-elegir-carpeta-de-guardado",
    "allow-abrir-carpeta-de-datos",
    "allow-informacion-de-soporte",
    "allow-reiniciar",
    "allow-elegir-carpeta",
    "allow-elegir-destino",
    "allow-guardar-en-destino"
  ]
}
