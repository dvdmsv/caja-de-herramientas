{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caja de herramientas",
  "version": "0.1.3",
  "identifier": "io.github.dvdmsv.cajadeherramientas",
  "build": {
    "frontendDist": "../arranque"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "dvdmsv",
    "homepage": "https://github.com/dvdmsv/caja-de-herramientas",
    "copyright": "AGPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Caja de herramientas para PDF e imágenes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/merge-pdf-backend/": "backend/",
      "../dist/vendor/": "vendor/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "windows/ganchos.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMDkzNjdDNjQ3NDY2QjAKUldTd1puUmtmRFlKL1lkVTdRZWIySlQzaUJ2bm0rSFJmMXNMbjJBSU94b1JDUUM1OTNwemZ6NWkK",
      "endpoints": [
        "https://github.com/dvdmsv/caja-de-herramientas/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
