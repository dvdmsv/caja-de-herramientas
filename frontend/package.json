{
  "name": "merge-pdf",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "iconos": "node scripts/comprobar-iconos.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "android:sync": "ng build --configuration production,android && node scripts/licencias-android.mjs && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "test:local": "vitest run --config vitest.local.config.ts",
    "test:android": "playwright test --config playwright.android.config.ts"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@kenjiuno/msgreader": "1.29.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "buffer": "6.0.3",
    "docx": "9.5.1",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "mupdf": "1.28.1",
    "parse5": "8.0.1",
    "pdfjs-dist": "^6.2.108",
    "postal-mime": "4.2.0",
    "qrcode": "1.5.4",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.14.4",
    "tesseract.js": "6.0.1",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-js": "1.6.11",
    "zone.js": "~0.15.1",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "@types/qrcode": "1.5.6",
    "fake-indexeddb": "6.2.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
