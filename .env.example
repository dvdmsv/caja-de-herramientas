# Configuración de la instalación.
#
#   cp .env.example .env
#
# Docker Compose lee el `.env` solo, sin decirle nada. **Normalmente no hace
# falta**: al arrancar, el backend le pregunta al cgroup cuántos núcleos y cuánta
# memoria tiene el contenedor, y se ajusta a eso. Esto es para cuando quieras
# llevarle la contraria.
#
# Lo que se calcula solo está marcado abajo como «(se calcula)». Si escribes un
# valor, manda el tuyo.
#
# Se leen al arrancar. Después de tocar algo:  docker compose up -d
# (no hace falta `--build`; eso sólo si cambia el código).
#
# Un valor que no sea un número no tumba el servidor: avisa por el log y sigue
# con el valor por defecto. Pero si te equivocas al escribir el NOMBRE de la
# variable no hay aviso ninguno, simplemente no se aplica. Para comprobarlo:
#
#   docker compose config | grep NOMBRE_DE_LA_VARIABLE


# ─── Capacidad ────────────────────────────────────────────────────────────────

# (se calcula) Procesos que atienden peticiones.
#
# Por defecto: los que quepan a 768 MB cada uno, sin pasar de los núcleos que
# haya ni de 4. Ese presupuesto no es sólo el worker —que ronda los 300 MB con
# las bibliotecas cargadas— sino también el programa pesado que puede estar
# lanzando (LibreOffice, ocrmypdf).
#
# Para verlo:  docker compose logs backend | grep "Máquina detectada"
#GUNICORN_WORKERS=1

# Peticiones a la vez dentro de cada proceso. Bastan hilos porque PyMuPDF y
# Pillow sueltan el GIL mientras trabajan.
#GUNICORN_THREADS=4

# Trabajos pesados simultáneos **por cada worker**, no en total: el semáforo vive
# en el proceso, así que los de verdad son GUNICORN_WORKERS × esto. Son los tres
# que arrancan un programa aparte —documento a PDF (LibreOffice), PDF a Word
# (pdf2docx) y el OCR (ocrmypdf)—, y comparten turno porque lo que se reparte es
# la memoria: un LibreOffice come entre 130 y 350 MB, y un OCR a cuatro núcleos,
# 327 MB.
#
# Se queda en 1 aposta: el cálculo de workers ya reserva sitio para uno por
# worker, así que con dos workers salen dos a la vez sin tocar nada.
#MAX_CONCURRENT_CONVERSIONS=1

# (se calcula) Páginas que el OCR reconoce en paralelo. Por defecto, los núcleos
# que haya. Es el ajuste que más se nota: medido con 60 páginas escaneadas en 4
# núcleos, con 1 tarda 36 s y consume 180 MB; con 4 tarda 21 s y consume 327 MB.
#OCR_JOBS=4

# Cuánto aprieta el OCR el PDF resultante, de 0 a 3. El 1 que viene por defecto
# sale prácticamente gratis: en la misma medición el archivo pasó de 2742 kB a
# 716 kB en el mismo tiempo. Subir a 2 o 3 aprieta más, a costa de tiempo.
#OCR_OPTIMIZE=1

# Memoria y núcleos del contenedor del backend. Son topes, no reservas: sólo se
# gasta lo que se use, y ponerlos protege al resto de la máquina de un desmadre.
#
# Pero son además **lo que el backend cree tener**: el autodimensionado pregunta
# al cgroup, no a la máquina, así que desplegar en un servidor más grande no
# cambia nada hasta que subes estos dos. Son la primera palanca, no la última.
#
# La guía completa, con recetas por tipo de máquina, está en
# docs/ajustar-a-la-maquina.md
#BACKEND_MEM_LIMIT=1536m
#BACKEND_CPUS=4.0


# ─── Plazos ───────────────────────────────────────────────────────────────────
# No hay límite de páginas en ninguna herramienta: lo que las acota es el tiempo.
# Si subes uno de estos, sube también GUNICORN_TIMEOUT, que tiene que ser SIEMPRE
# el mayor de todos. Si no, gunicorn corta la respuesta a medias y el usuario ve
# un error feo en vez de uno explicado.

#OCR_TIMEOUT_SECONDS=240
#PDF_TO_WORD_TIMEOUT_SECONDS=240
#DOC_TO_PDF_TIMEOUT_SECONDS=180

# Cuánto espera una petición a que le toque el turno de conversión.
#CONVERSION_QUEUE_TIMEOUT_SECONDS=45

# El plazo de gunicorn. Mayor que todos los de arriba.
#GUNICORN_TIMEOUT=300


# ─── Archivos ─────────────────────────────────────────────────────────────────

# Tamaño máximo de una petición completa, en MB. Ojo: nginx tiene el suyo
# (`client_max_body_size` en frontend/nginx.conf) y **manda el más bajo de los
# dos**. Subir sólo éste no sirve de nada: nginx viene con 200M, así que a partir
# de ahí hay que tocar los dos.
#MAX_CONTENT_LENGTH_MB=200

# Cuánto sobreviven los archivos subidos sin actividad, y cada cuánto pasa el
# recolector que los borra.
#SESSION_TTL_MINUTES=120
#CLEANUP_INTERVAL_MINUTES=15

# Dónde se guardan. La única de esta lista que **no se pasa al contenedor**: en
# Docker es un volumen y lo decide `docker-compose.yml`. Sirve para el modo de
# desarrollo, ejecutando el backend a mano.
#UPLOAD_ROOT=uploads


# ─── Sello de tiempo ──────────────────────────────────────────────────────────
# Sólo se usa si marcas la casilla al firmar. Es la única salida a internet de
# toda la aplicación, y lo único que manda es un resumen del documento.

#TSA_URL=https://freetsa.org/tsr
#TSA_TIMEOUT_SECONDS=15
