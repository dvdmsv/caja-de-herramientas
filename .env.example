# Configuración de la instalación.
#
#   cp .env.example .env
#
# Docker Compose lee el `.env` solo, sin decirle nada. **Normalmente no hace
# falta**: cada servicio le pregunta al cgroup cuántos núcleos y cuánta memoria
# tiene su contenedor, y se ajusta a eso. Esto es para cuando quieras llevarle
# la contraria.
#
# Lo que se calcula solo está marcado como «(se calcula)». Si escribes un valor,
# manda el tuyo.
#
# Se leen al arrancar. Después de tocar algo:  docker compose up -d
# (no hace falta `--build`; eso sólo si cambia el código).
#
# Un valor que no sea un número no tumba el servidor: avisa por el log y sigue
# con el valor por defecto. Pero si te equivocas al escribir el NOMBRE de la
# variable no hay aviso ninguno, simplemente no se aplica. Para comprobarlo:
#
#   docker compose config | grep NOMBRE_DE_LA_VARIABLE


# ─── Despliegue ───────────────────────────────────────────────────────────────

# Que `docker compose up -d` retire los contenedores de servicios que ya no
# están en este archivo. Sin esto, al renombrar o quitar un servicio el viejo se
# queda corriendo y consumiendo memoria hasta que alguien lo note: pasó al
# separar el backend en tres. Compose sólo lo hace con `--remove-orphans`, y
# quien lanza el despliegue aquí es un script de la máquina que no lo pasa; por
# variable de entorno se consigue igual.
COMPOSE_REMOVE_ORPHANS=true


# ─── Los tres servicios ───────────────────────────────────────────────────────
#
# La misma imagen hace tres papeles (ver la cabecera de `backend/app.py`):
#
#   web      subidas, descargas, ZIP y sesión. No carga ninguna biblioteca
#            pesada: 58 MB en reposo, medido.
#   ligeros  vistas previas, inspecciones, listas de formatos y QR.
#   pesados  el trabajo de verdad: OCR, ofimática, rasterizado, firma.
#
# Los dos de trabajo atienden **cada petición en un proceso que muere al
# terminar**, con sus propios límites de memoria y de CPU. El tope de memoria del
# contenedor es lo que decide cuántos caben:
#
#     trabajos a la vez  =  (tope del contenedor − 256 MB de maestro) / memoria por trabajo
#
# Para ver con qué ha arrancado cada uno:
#
#   docker compose logs pesados | grep "trabajos a la vez"
#
# Dentro del contenedor estas variables se llaman de otra forma
# (`GUNICORN_WORKERS`, `TRABAJOS_A_LA_VEZ`, `JOB_MEMORY_MB`, `JOB_CPU_SECONDS`):
# `docker-compose.yml` traduce las de aquí a las de allí, y por eso hay una por
# servicio en vez de una sola para los tres.

# Tope de memoria de cada servicio. Son la **entrada del cálculo**, no sólo una
# protección: súbelos y el servicio atiende más a la vez.
#WEB_MEM_LIMIT=256m
#LIGEROS_MEM_LIMIT=640m
#PESADOS_MEM_LIMIT=2048m

# Núcleos de cada uno. `pesados` se los reparte entre sus trabajos (el OCR mira
# esto para saber cuántas páginas reconocer en paralelo).
#WEB_CPUS=1.0
#LIGEROS_CPUS=2.0
#PESADOS_CPUS=4.0

# (se calcula) Cuántas peticiones a la vez admite cada servicio de trabajo.
# Con los valores de arriba salen 2 y 2.
#LIGEROS_TRABAJOS=2
#PESADOS_TRABAJOS=2

# (se calcula) Memoria por trabajo. El tope se lo comen también los programas
# que lance el trabajo, que lo heredan: medido con `ulimit -d`, LibreOffice
# convierte con 384 MB, pero pdf2docx (que arrastra OpenCV) necesita 768 y por
# debajo de eso se cae con violación de segmento.
#LIGEROS_JOB_MEMORY_MB=192
#PESADOS_JOB_MEMORY_MB=768

# (se calcula) Segundos de CPU por trabajo. Protege del bucle infinito que no
# pide memoria. Por defecto, el mismo plazo del servicio.
#LIGEROS_JOB_CPU_SECONDS=30
#PESADOS_JOB_CPU_SECONDS=300

# (se calcula) Tamaño máximo de un archivo escrito por un trabajo. Un resultado
# puede pesar más que su entrada: un PDF a 300 ppp son muchas imágenes.
#PESADOS_JOB_OUTPUT_MB=512

# El servicio `web` sí usa hilos: casi todo su trabajo es esperar al disco.
#WEB_WORKERS=1
#WEB_THREADS=4
#WEB_TIMEOUT=300

# Plazo de cada servicio de trabajo, la última red por debajo de la cual cada
# herramienta tiene el suyo.
#LIGEROS_TIMEOUT=60
#PESADOS_TIMEOUT=300


# ─── Topes por trabajo ────────────────────────────────────────────────────────
# El tamaño del archivo no dice lo que va a costar procesarlo, y estos topes sí.

# Megapíxeles máximos de una imagen o de una página al rasterizarla. Son unos
# 160 MB en memoria, y de sobra para una A4 a 600 ppp (35 MP). Lo que corta son
# las páginas de tamaño cartel: una de 5000×5000 puntos a 150 ppp son 109 MP.
#MAX_IMAGE_MEGAPIXELS=40

# Lo que puede ocupar **descomprimido** un documento que por dentro es un ZIP
# (.docx, .xlsx, .pptx, .epub, .odt). Un archivo de 2 MB puede traer gigas.
#MAX_UNZIPPED_MB=400

# Cuánto puede llevar esperando una petición antes de que no valga la pena
# atenderla: si ha pasado tanto tiempo en la cola, quien la mandó ya no está.
#REQUEST_MAX_AGE_SECONDS=60


# ─── Plazos de las herramientas ───────────────────────────────────────────────
# No hay límite de páginas en ninguna: lo que las acota es el tiempo. Cada plazo
# tiene que quedar por debajo del de su servicio (`PESADOS_TIMEOUT`), o el corte
# lo dará gunicorn y el usuario verá un error feo en vez de uno explicado.

#OCR_TIMEOUT_SECONDS=240
#PDF_TO_WORD_TIMEOUT_SECONDS=240
#DOC_TO_PDF_TIMEOUT_SECONDS=180

# Rasterizar, comprimir y extraer imágenes: trabajos que ocurren dentro del
# proceso, no como programa aparte.
#RASTER_TIMEOUT_SECONDS=180

# Pasar a Markdown y maquetar el PDF desde Markdown.
#MARKDOWN_TIMEOUT_SECONDS=120

# Comparar dos PDF: rasteriza los dos documentos y maqueta el informe al final,
# así que se le da más margen que a un trabajo de una sola pasada.
#COMPARE_TIMEOUT_SECONDS=180

# Cuánto espera un trabajo a que le toque el turno. **Sólo afecta a
# `python app.py`**: en producción no hay turno, el tope es el número de
# procesos de `pesados`.
#CONVERSION_QUEUE_TIMEOUT_SECONDS=45
#MAX_CONCURRENT_CONVERSIONS=1


# ─── OCR ──────────────────────────────────────────────────────────────────────

# (se calcula) Páginas que reconoce en paralelo: los núcleos del contenedor
# repartidos entre sus trabajos. Medido con 60 páginas escaneadas: con 1 tarda
# 36 s y con 4, 21 s.
#OCR_JOBS=2

# Cuánto aprieta el PDF resultante, de 0 a 3. El 1 sale casi gratis: en la misma
# medición, el archivo pasó de 2742 kB a 716 kB en el mismo tiempo.
#OCR_OPTIMIZE=1


# ─── Archivos y disco ─────────────────────────────────────────────────────────

# Tamaño máximo de una petición completa, en MB. Ojo: nginx tiene el suyo
# (`client_max_body_size` en frontend/nginx.conf) y **manda el más bajo de los
# dos**; nginx viene con 200M.
#MAX_CONTENT_LENGTH_MB=200

# Lo que puede acumular una sola sesión, contando subidas y resultados. Es lo
# que evita que alguien repita la subida veinte veces y se lleve el disco.
#SESSION_QUOTA_MB=1024

# Espacio que nunca se toca. El volumen comparte disco con todo lo demás de la
# máquina: llenarlo no rompe sólo esta aplicación. Al acercarse, se desalojan
# las sesiones más viejas.
#DISK_RESERVE_MB=1024

# Una sesión con actividad más reciente que esto no se desaloja nunca, aunque
# haga falta sitio: alguien está trabajando con ella.
#SESSION_PROTECTED_MINUTES=10

# Cuánto sobreviven los archivos sin actividad, y cada cuánto pasa el recolector
# que los borra. El recolector vive sólo en el servicio `web`.
#SESSION_TTL_MINUTES=120
#CLEANUP_INTERVAL_MINUTES=15

# Dónde se guardan. En Docker es un volumen compartido por los tres servicios,
# así que esto sólo sirve para el modo de desarrollo.
#UPLOAD_ROOT=uploads


# ─── Sello de tiempo ──────────────────────────────────────────────────────────
# Sólo se usa si marcas la casilla al firmar. Es la única salida a internet de
# toda la aplicación, y lo único que manda es un resumen del documento.

#TSA_URL=https://freetsa.org/tsr
#TSA_TIMEOUT_SECONDS=15
